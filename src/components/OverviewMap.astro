---
// Homepage locator: every study area in the portfolio on one Equal Earth map.
import { overviewMap } from '../lib/geo';

interface Site {
  name: string;
  coords: [number, number];
  anchor: 'start' | 'end';
  dx: number;
  dy: number;
  projects: { title: string; href: string }[];
}
interface Props {
  sites: Site[];
  national: { title: string; href: string }[];
}
const { sites, national } = Astro.props;
const W = 1180;
const H = 420;
const m = overviewMap(W, H);
---
<figure class="overview">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="overview-title">
    <title id="overview-title">Map of study areas: Seattle, San Francisco, the United States and Addis Ababa</title>
    <defs>
      <clipPath id="sphere-clip"><path d={m.sphere} /></clipPath>
    </defs>
    <g clip-path="url(#sphere-clip)">
      <rect width={W} height={H} fill="var(--water-tint)" />
      <path d={m.graticule} fill="none" stroke="#cddcea" stroke-width="0.6" />
      <path d={m.land} fill="#dde7d6" />
      <path d={m.usa} fill="#c4d8b6" />
      <path d={m.borders} fill="none" stroke="#a9bea0" stroke-width="0.6" />
    </g>
    <text class="region" x={m.project([-100, 40.5])[0]} y={m.project([-100, 40.5])[1]} text-anchor="middle">United States</text>
    {sites.map((s) => {
      const [x, y] = m.project(s.coords);
      return (
        <g class="site">
          <line x1={x} y1={y} x2={x + s.dx * 0.82} y2={y + s.dy - 5} stroke="var(--ink-2)" stroke-width="0.8" />
          <circle cx={x} cy={y} r="5" fill="var(--contour)" stroke="#fff" stroke-width="1.6" />
          <text x={x + s.dx} y={y + s.dy} text-anchor={s.anchor}>{s.name}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>
    <dl class="key">
      {sites.map((s) => (
        <div>
          <dt>{s.name}</dt>
          {s.projects.map((p) => <dd><a href={p.href}>{p.title}</a></dd>)}
        </div>
      ))}
      <div>
        <dt>United States, national</dt>
        {national.map((p) => <dd><a href={p.href}>{p.title}</a></dd>)}
      </div>
    </dl>
  </figcaption>
</figure>

<style>
  .overview { margin: 0; }
  svg { width: 100%; height: auto; border-radius: 6px; }
  .region {
    font: 500 15px var(--font);
    font-variation-settings: 'wdth' 125;
    letter-spacing: 0.12em;
    fill: #7f9a73;
  }
  .site text {
    font: 620 17px var(--font);
    font-variation-settings: 'wdth' 110;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--water-tint);
    stroke-width: 4px;
  }
  .key {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin: 1.25rem 0 0;
  }
  dt { font-weight: 620; font-variation-settings: 'wdth' 110; color: var(--contour); margin-bottom: 0.25rem; }
  dd { margin: 0 0 0.2rem; font-size: var(--s-1); }
  @media (max-width: 820px) {
    .key { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .key { grid-template-columns: 1fr; }
    .site text { font-size: 30px; }
    .region { font-size: 24px; }
  }
</style>
